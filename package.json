{
  "name": "iriguchi",
  "version": "0.0.0",
  "private": true,
  "description": "Iriguchi — the gate app for entrance operators; requires connectivity",
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo/export-check",
    "deps:check": "expo install --check",
    "lint:copy": "node tools/copy-lint/cli.ts",
    "screens:write": "node tools/screens/cli.ts write",
    "screens:check": "node tools/screens/cli.ts check",
    "vendor:libticketto": "tools/vendor-libticketto.sh",
    "vendor:check": "tools/vendor-libticketto.sh --check && tools/vendor-kippu-api.sh --check",
    "fixtures:write": "node tools/fixtures/cli.ts",
    "vendor:kippu-api": "tools/vendor-kippu-api.sh"
  },
  "dependencies": {
    "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz",
    "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "expo": "57.0.22",
    "expo-camera": "57.0.5",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-image-loader": "57.0.1",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@kippu/api": "file:vendor/kippu-api/kippu-api-0.0.0.tgz",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "jsqr": "1.4.0",
    "oxc-parser": "0.149.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "expo-camera"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@ticketto/sdk": "file:vendor/libticketto/ticketto-sdk-0.0.0.tgz",
      "@ticketto/profile-v0": "file:vendor/libticketto/ticketto-profile-v0-0.0.0.tgz"
    },
    "patchedDependencies": {
      "expo-camera@57.0.5": "patches/expo-camera@57.0.5.patch"
    }
  }
}
